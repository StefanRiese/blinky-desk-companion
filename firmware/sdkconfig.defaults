# Waveshare ESP32-S3-Touch-LCD-1.46: ESP32-S3R8 (8 MB octal PSRAM), 16 MB QIO flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Optimized for speed (-O2). Without it ESP-IDF builds for debugging (-Og), and LVGL's
# software renderer needed 45 ms for the eyes on the AMOLED-1.75 (10-20 FPS)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Updates go to the other app partition; a new app that doesn't come up is rolled back
# (app_main marks it valid once the UI runs). Needs the new bootloader: flash once over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The task watchdog (idle tasks starved for 5 s) panics and restarts instead of only
# logging: a hung device restarts, and a new app that hangs before it is marked valid
# goes back to the previous one.
CONFIG_ESP_TASK_WDT_PANIC=y
# A crash writes a core dump to the coredump partition (read it with idf.py coredump-info).
# A board updated over the air keeps its old partition table without it: then there is no
# dump, and everything else works.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# Its log strings would sit in internal RAM; it costs a 1.8 KB stack there anyway
# CONFIG_ESP_COREDUMP_LOGS is not set

# PSRAM: octal, 80 MHz, usable by malloc (LVGL allocates from it)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# No memory test of the whole PSRAM at each start (210 ms); a bad chip shows anyway
# CONFIG_SPIRAM_MEMTEST is not set
# malloc() goes to PSRAM first, whatever the size (default: below 16 KB stays internal).
# LVGL's widgets, styles and texts are many small allocations and filled the internal
# RAM, so TLS, sockets and even the MMU ran out ("no mem"). Task stacks, FreeRTOS objects,
# drivers and WiFi ask for internal or DMA memory themselves; 64 KB stay reserved for them.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# PSRAM speed: LVGL's objects and buffers live there, and drawing the eyes waited mostly
# for memory (38 ms per frame at -O2). A 64 KB data cache with 64-byte lines (costs 32 KB
# of internal RAM, paid for by the rotation buffer that only a turned picture gets), and
# code and constants run from the octal PSRAM, which is faster than the quad flash.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Console and the host link use the native USB port (USB-Serial-JTAG, no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9: RGB565, system malloc (PSRAM); UI fonts are generated (tools/fonts.sh),
# Montserrat 14 stays as LVGL's default font
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_OBSERVER=y
# LVGL's FPS and CPU counter, shown with the setting ui.fps (hidden by default), at the
# bottom middle inside the round glass
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_MID=y
# Redraw every 16 ms: with 33 ms, the eyes' 33 ms animation timer and the refresh drift
# against each other and steps are drawn late or skipped (stutter)
CONFIG_LV_DEF_REFR_PERIOD=16

# WiFi and network: WiFi/lwIP buffers in PSRAM where possible (internal RAM is for the
# display DMA buffers); sockets for the web page (4), TCP link, HTTPS, DNS, mDNS, NTP
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# WiFi code stays in flash/PSRAM, not in IRAM: on the S3 IRAM and the internal heap share
# the same SRAM, and the two options cost more than 10 KB and 17 KB of it. They only
# speed up WiFi throughput, which Blinky doesn't need (WiFi took 92 KB at start with them).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# 8 static RX buffers instead of 16 (the default with WiFi in PSRAM): they are always in
# internal RAM, 1.6 KB each. The Block Ack window must not be larger than their number.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# TLS buffers (2 × 16 KB per connection) in PSRAM, not in the scarce internal RAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_LOCAL_HOSTNAME="blinky"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Size: everything below only leaves out code Blinky doesn't use. With XIP from PSRAM the
# whole app is copied to PSRAM at start, so flash saved is PSRAM saved.
# LVGL's examples aren't needed (and need the widgets)
# CONFIG_LV_BUILD_EXAMPLES is not set
# LVGL widgets the UI doesn't use (it has obj, label, line, arc, bar; images for layers)
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SLIDER is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_SWITCH is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# IPv4 only: the links, mDNS and HTTPS use IPv4 (a host reachable only over IPv6 can't be
# fetched from the device; Buddy Link still can)
# CONFIG_LWIP_IPV6 is not set
# The CA bundle with the certificates that cover nearly all sites (Open-Meteo, ipinfo.io,
# GitHub) instead of all of Mozilla's; an http source on a site with a rare CA fails on the
# device and is fetched by Buddy Link instead (via: host)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# No WPA Enterprise (EAP): the settings have no fields for it
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
