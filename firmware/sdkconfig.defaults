# Waveshare ESP32-S3-Touch-LCD-1.46: ESP32-S3R8 (8 MB octal PSRAM), 16 MB QIO flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# Updates go to the other app partition; a new app that doesn't come up is rolled back
# (app_main marks it valid once the UI runs). Needs the new bootloader: flash once over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# PSRAM: octal, 80 MHz, usable by malloc (LVGL allocates from it)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# malloc() goes to PSRAM first, whatever the size (default: below 16 KB stays internal).
# LVGL's widgets, styles and texts are many small allocations and filled the internal
# RAM, so TLS, sockets and even the MMU ran out ("no mem"). Task stacks, FreeRTOS objects,
# drivers and WiFi ask for internal or DMA memory themselves; 64 KB stay reserved for them.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Console and the host link use the native USB port (USB-Serial-JTAG, no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9: RGB565, system malloc (PSRAM); UI fonts are generated (tools/fonts.sh),
# Montserrat 14 stays as LVGL's default font
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_OBSERVER=y

# WiFi and network: WiFi/lwIP buffers in PSRAM where possible (internal RAM is for the
# display DMA buffers); sockets for the web page (4), TCP link, HTTPS, DNS, mDNS, NTP
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# TLS buffers (2 × 16 KB per connection) in PSRAM, not in the scarce internal RAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_LOCAL_HOSTNAME="blinky"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
