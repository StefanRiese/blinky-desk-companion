# Waveshare ESP32-S3-Touch-LCD-1.46: ESP32-S3R8 (8 MB octal PSRAM), 16 MB QIO flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: octal, 80 MHz, usable by malloc (LVGL allocates from it)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Console and the host link use the native USB port (USB-Serial-JTAG, no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL 9: RGB565, system malloc (PSRAM), fonts used by the UI
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_OBSERVER=y
